{
  "name": "@cdlab/fingerprintd",
  "version": "0.1.0",
  "description": "Pure-TypeScript browser SDK for the fingerprintd challenge/identify flow (collect-only; the server judges).",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "fingerprinting",
    "device-fingerprint",
    "browser-sdk",
    "anti-fraud",
    "fingerprintjs"
  ],
  "homepage": "https://github.com/WuChenDi/fingerprintd/tree/main/packages/client#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuchendi/fingerprintd.git",
    "directory": "packages/client"
  },
  "bugs": {
    "url": "https://github.com/WuChenDi/fingerprintd/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fingerprintjs/botd": "^2.0.0",
    "@fingerprintjs/fingerprintjs": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "jsdom": "^30.1.2",
    "tsdown": "^0.23.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
