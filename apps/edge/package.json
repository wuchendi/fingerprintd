{
  "name": "@cdlab/fingerprintd-edge",
  "version": "0.1.0",
  "description": "Cloudflare Worker edge deployment of the fingerprintd challenge/identify flow (TS host + Rust/WASM compute).",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "keywords": [
    "fingerprinting",
    "cloudflare-workers",
    "edge",
    "anti-fraud",
    "wasm"
  ],
  "homepage": "https://github.com/WuChenDi/fingerprintd/tree/main/apps/edge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WuChenDi/fingerprintd.git",
    "directory": "apps/edge"
  },
  "bugs": {
    "url": "https://github.com/WuChenDi/fingerprintd/issues"
  },
  "scripts": {
    "dev": "nsl run --name \"fingerprintd-edge\" -f wrangler dev --local",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy:dry": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy --minify",
    "db:gen": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "cf:d1config": "bun scripts/d1-config.ts",
    "cf:localdb": "bun scripts/d1-config.ts && wrangler d1 migrations apply fingerprintd -c wrangler.d1.jsonc --local",
    "cf:remotedb": "bun scripts/d1-config.ts && wrangler d1 migrations apply fingerprintd -c wrangler.d1.jsonc --remote"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261011.1",
    "@types/node": "catalog:",
    "drizzle-kit": "^0.31.11",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
