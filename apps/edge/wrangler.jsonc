/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // fingerprintd edge Worker. Runs with no account locally (`wrangler dev
  // --local`, the miniflare-backed vitest suite) and deploys to Cloudflare via
  // `.github/workflows/deploy-edge.yml` (or `bun run deploy`). The database is
  // a libSQL server (e.g. Turso) by default, or D1 with `DB_TYPE=d1`; SQLite-
  // backed Durable Objects + D1 are on the Workers free plan. Worker Secrets,
  // never committed — set via `wrangler secret put` or the deploy workflow's
  // sync: FP_SALT_SECRET (required; the Worker throws without it),
  // FP_ADMIN_KEY, LIBSQL_URL, LIBSQL_AUTH_TOKEN, plus the optional FP_PROBE_KEY
  // and FP_SIGNING_KEY.
  "name": "fingerprintd-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-07",
  "compatibility_flags": ["nodejs_compat"],
  // Keep vars set in the dashboard across deploys instead of overwriting them
  // with the [vars] below.
  "keep_vars": true,
  // Non-secret defaults. Secrets are set with `wrangler secret put <NAME>` /
  // `.dev.vars`, never committed. Probe, signing, and the timestamp window stay
  // off until their secrets/vars are set; nonce TTL is 30s.
  "vars": {
    "FP_NONCE_TTL_SECS": "30",
    "FP_TS_SKEW_SECS": "30",
    // Client-integrity `noise` verdicts are surfaced in `signals.client_integrity`
    // always; set to "1" to let them lower confidence (off until the false-positive
    // rate on real traffic is known — privacy tooling trips the same probes).
    "FP_INTEGRITY_PENALTY_ENABLED": "0",
    // Allowed browser CORS origins (comma-separated; `*` = any). Set to the web
    // playground deployment so it can call /challenge and /identify cross-origin.
    "FP_CORS_ORIGINS": "https://fingerprintd.pages.dev",
    // Check-in retention is off by default: set CHECKIN_RETENTION_SECS > 0 to have
    // the scheduled cron purge old check-in events from the database.
    "CHECKIN_RETENTION_SECS": "0",
    // Fingerprint templates not seen for 30 days are purged by the daily cron
    // (0 disables the purge).
    "FP_RETENTION_SECS": "2592000",
    // Driver selector — "libsql" (default) reads the LIBSQL_URL /
    // LIBSQL_AUTH_TOKEN secrets; "d1" uses the `DB` binding (`d1_databases`).
    "DB_TYPE": "libsql"
  },
  // Durable Objects (both required): the one-time nonce store (atomic
  // check-and-burn `env.NONCE`) and the new-device velocity counter
  // (`env.VELOCITY`), each SQLite-backed.
  "durable_objects": {
    "bindings": [
      {
        "name": "NONCE",
        "class_name": "NonceDurableObject"
      },
      {
        "name": "VELOCITY",
        "class_name": "VelocityDurableObject"
      }
    ]
  },
  // SQLite-backed Durable Object storage. v1 for the nonce class; v2 adds the
  // new-device velocity class.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["NonceDurableObject"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["VelocityDurableObject"]
    }
  ],
  // D1 database (`env.DB`), only for DB_TYPE=d1: the fingerprint library +
  // blocking index AND the check-in event log, with one migration set
  // (./drizzle). Kept commented while libSQL is the driver; `bun run
  // cf:d1config` writes wrangler.d1.jsonc with it enabled, which `cf:localdb` /
  // `cf:remotedb` use to apply migrations. To deploy on D1, uncomment it and set
  // DB_TYPE to "d1".
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "fingerprintd",
  //     "migrations_dir": "./drizzle",
  //     "database_id": "7b0d1ed4-8094-4f0f-aa46-6afa6e9f14c6"
  //   }
  // ],
  // Per-IP rate limits (both bindings required). `env.RATE_LIMIT` covers
  // POST /identify and POST /checkin/assess: 60 requests per IP per 60s.
  // `env.CHALLENGE_RATE_LIMIT` covers GET /challenge on its own bucket so a
  // challenge flood cannot lock out identify; 120 per IP per 60s, with the 2x
  // headroom bounded because every challenge also costs a Durable Object write.
  // `period` accepts only 10 or 60.
  "unsafe": {
    "bindings": [
      {
        "name": "RATE_LIMIT",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 60, "period": 60 }
      },
      {
        "name": "CHALLENGE_RATE_LIMIT",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": { "limit": 120, "period": 60 }
      }
    ]
  },
  // Retention purge: the `scheduled` handler in src/index.ts runs daily
  // at 03:00 UTC, deleting templates older than FP_RETENTION_SECS and check-in
  // events older than CHECKIN_RETENTION_SECS (0 ⇒ that purge is a no-op).
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
