{
  "name": "@cdlab/fingerprintd-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Browser playground for the fingerprintd challenge/identify flow — runs the @cdlab/fingerprintd SDK against a server and visualizes the result.",
  "keywords": [
    "fingerprinting",
    "playground",
    "react",
    "anti-fraud",
    "demo"
  ],
  "homepage": "https://github.com/WuChenDi/fingerprintd/tree/main/apps/web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WuChenDi/fingerprintd.git",
    "directory": "apps/web"
  },
  "bugs": {
    "url": "https://github.com/WuChenDi/fingerprintd/issues"
  },
  "scripts": {
    "dev": "nsl run --name \"fingerprintd-web\" -f vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome check",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler pages deploy --branch main"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
