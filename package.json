{
  "name": "fingerprintd",
  "version": "0.0.2",
  "description": "Server-side device fingerprinting: Rust cargo workspace (server + fp-core + fp-wasm) plus a Bun workspace for the TS packages.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "keywords": [
    "fingerprinting",
    "anti-fraud",
    "device-fingerprint",
    "bot-detection",
    "security"
  ],
  "homepage": "https://github.com/WuChenDi/fingerprintd#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WuChenDi/fingerprintd.git"
  },
  "bugs": {
    "url": "https://github.com/WuChenDi/fingerprintd/issues"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "@fingerprintjs/fingerprintjs": "^5.3.0",
      "@types/node": "^26.6.5",
      "typescript": "^7.0.2",
      "vitest": "^4.1.11",
      "wrangler": "^4.149.0"
    }
  },
  "scripts": {
    "dev": "bun run --filter=./apps/* dev",
    "dev:web": "bun run --filter '@cdlab/fingerprintd-web' dev",
    "dev:edge": "bun run --filter '@cdlab/fingerprintd-edge' dev",
    "lint": "biome check .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "build": "bun run --filter '*' build",
    "build:wasm": "bash scripts/build-wasm.sh",
    "deploy:cf": "bash scripts/deploy-cf.sh",
    "clean": "bash scripts/clean.sh",
    "verify:edge": "bun scripts/verify-deploy.ts",
    "prepare": "bash scripts/prepare.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15"
  },
  "overrides": {
    "fast-uri": "^3.1.8",
    "sharp": "^0.35.5",
    "brace-expansion": "^5.0.12",
    "postcss": "^8.5.18"
  }
}
